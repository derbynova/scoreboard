<Layouts.app flash={@flash} game>
  <div id="game-library" class="space-y-8 py-8">
    <header class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-medium uppercase tracking-widest text-base-content/60">
          DerbyNova Scoreboard
        </p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight">Your matches</h1>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-base-content/70">
          Start a match, return to the controls, or review a saved result.
        </p>
      </div>
      <button
        id="new-game"
        phx-click="create_game"
        phx-disable-with="Creating…"
        class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-emerald-400 px-5 py-3 font-semibold text-slate-950 shadow-sm transition hover:bg-emerald-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-400"
      >
        <.icon name="hero-plus" class="size-5" /> New Game
      </button>
    </header>

    <section
      aria-labelledby="saved-games-heading"
      class="rounded-xl border border-base-content/15"
    >
      <div class="flex items-center justify-between gap-4 border-b border-base-content/10 px-6 py-4">
        <div>
          <h2 id="saved-games-heading" class="font-semibold">Saved matches</h2>
          <p class="mt-1 text-xs text-base-content/60">
            Most recently saved first · times in UTC
          </p>
        </div>
        <button
          id="refresh-games"
          phx-click="refresh_games"
          class="inline-flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition hover:bg-base-content/10 focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          <.icon name="hero-arrow-path" class="size-4" /> Refresh
        </button>
      </div>
      <p
        :if={@storage_error}
        id="games-storage-error"
        role="alert"
        class="m-6 rounded-lg border border-amber-400/40 bg-amber-400/10 p-4 text-sm"
      >
        Saved matches could not be loaded. Check local storage, then refresh. Previously displayed results may be out of date.
      </p>
      <div id="saved-games" phx-update="stream" class="divide-y divide-base-content/10">
        <div
          id="no-saved-games"
          class={["hidden px-6 py-12 text-center", !@storage_error && "only:block"]}
        >
          <.icon name="hero-clipboard-document-list" class="mx-auto size-8 text-base-content/50" />
          <h3 class="mt-4 font-medium">No saved matches to display</h3>
          <p class="mt-2 text-sm text-base-content/60">
            Create a match to get started. It will be saved automatically.
          </p>
        </div>
        <article :for={{dom_id, game} <- @streams.games} id={dom_id} class="px-6 py-5">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="font-medium">
                  Home <span class="px-1 text-base-content/50">vs</span> Away
                </h3>
                <span class="rounded-full bg-base-content/10 px-2 py-1 text-xs font-medium">
                  {if game.valid?, do: phase_label(game.phase), else: "Unavailable"}
                </span>
              </div>
              <p class="mt-2 break-all font-mono text-xs text-base-content/60">{game.id}</p>
              <time
                datetime={DateTime.to_iso8601(game.saved_at)}
                class="mt-1 block text-xs text-base-content/60"
              >
                {Calendar.strftime(game.saved_at, "%d %b %Y · %H:%M UTC")}
              </time>
            </div>
            <div :if={game.valid?} class="flex flex-wrap items-center gap-4">
              <p
                class="text-2xl font-semibold tabular-nums"
                aria-label={"Home #{game.score_home}, Away #{game.score_away}"}
              >
                {game.score_home} <span class="text-base-content/40">–</span> {game.score_away}
              </p>
              <.link
                :if={game.phase != :final}
                id={"resume-#{game.id}"}
                navigate={~p"/games/#{game.id}/operator"}
                class="rounded-lg border border-base-content/20 px-4 py-2 text-sm font-semibold transition hover:bg-base-content/10 focus-visible:outline-2 focus-visible:outline-offset-2"
              >
                {if game.phase == :initial, do: "Open controls", else: "Resume match"}
              </.link>
            </div>
          </div>
          <p :if={!game.valid?} class="mt-3 text-sm text-base-content/70">
            This saved match could not be read. Its data has been kept.
          </p>
          <details
            :if={game.valid? and game.phase == :final}
            id={"summary-#{game.id}"}
            class="mt-4 rounded-lg bg-base-content/5 p-4"
          >
            <summary class="cursor-pointer text-sm font-medium">View summary</summary>
            <div class="mt-3 space-y-3 text-sm text-base-content/70">
              <p>Final score: Home {game.score_home} · Away {game.score_away}</p>
              <p>Period {game.period} · Jam {game.jam_number}</p>
              <.link
                id={"audience-#{game.id}"}
                navigate={~p"/games/#{game.id}/scoreboard"}
                class="inline-block font-medium underline underline-offset-4"
              >
                Open public display
              </.link>
            </div>
          </details>
        </article>
      </div>
      <div :if={@cursor} class="border-t border-base-content/10 p-4 text-center">
        <button
          id="load-more-games"
          phx-click="load_more"
          phx-disable-with="Loading…"
          class="rounded-lg px-4 py-2 text-sm font-medium transition hover:bg-base-content/10 focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          Load older matches
        </button>
      </div>
    </section>

    <section aria-labelledby="join-heading" class="rounded-xl bg-base-content/5 p-6">
      <h2 id="join-heading" class="font-medium">Open a public display</h2>
      <p class="mt-1 text-sm text-base-content/60">Enter the match ID shared by the operator.</p>
      <.form
        for={@form}
        id="join-game-form"
        phx-submit="join_game"
        class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-start"
      >
        <div class="flex-1">
          <.input
            field={@form[:game_id]}
            id="join-game-id"
            type="text"
            placeholder="Match ID"
            aria-label="Match ID"
            required
            class="w-full rounded-lg border border-base-content/20 bg-base-100 px-4 py-3 text-sm outline-none focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30"
          />
        </div>
        <button
          id="join-game"
          type="submit"
          class="rounded-lg border border-base-content/20 px-4 py-3 text-sm font-semibold transition hover:bg-base-content/10 focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          Join Game
        </button>
      </.form>
    </section>
  </div>
</Layouts.app>
